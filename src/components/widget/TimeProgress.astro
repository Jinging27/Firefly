---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import TimeProgressClient from "@/components/widget/TimeProgressClient.svelte";
import { timeProgressConfig } from "@/config";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getBeijingMonthProgress,
	getBeijingWeekProgress,
	getBeijingYearProgress,
	getNextHolidayCountdown,
	getNextSpringFestivalCountdown,
} from "@/utils/time-progress";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const now = new Date();
const initial = {
	year: getBeijingYearProgress(now),
	month: getBeijingMonthProgress(now),
	week: getBeijingWeekProgress(now),
	holiday: getNextHolidayCountdown(now, timeProgressConfig.holidays),
	springFestival: getNextSpringFestivalCountdown(
		now,
		timeProgressConfig.springFestivals,
	),
};
const showTitle = widgetConfig?.showTitle !== false;
const widgetClass = [className, "time-progress-widget"]
	.filter(Boolean)
	.join(" ");
---

<WidgetLayout name={timeProgressConfig.title} showTitle={showTitle} id="time-progress" class={widgetClass} {style}>
	<div data-time-progress-widget>
	<TimeProgressClient
		client:visible
		initial={initial}
		holidays={timeProgressConfig.holidays}
		springFestivals={timeProgressConfig.springFestivals}
	/>
	</div>
</WidgetLayout>

<style>
	:global(.time-progress-widget) { display: none; }
	@media (min-width: 1280px) {
		:global(.time-progress-widget:not(.hidden)) { display: block; }
	}
</style>
