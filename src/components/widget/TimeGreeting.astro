---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import TimeGreetingClient from "@/components/widget/TimeGreetingClient.svelte";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const widgetClass = [className, "time-greeting-widget"]
	.filter(Boolean)
	.join(" ");
const isPostPage = Astro.url.pathname.includes("/posts/");
---

{!isPostPage && (
	<WidgetLayout
		name="时段问候"
		{showTitle}
		id="time-greeting"
		class={widgetClass}
		{style}
	>
		<TimeGreetingClient client:visible />
	</WidgetLayout>
)}

<style>
	:global(.time-greeting-widget) {
		display: none;
	}

	@media (min-width: 1280px) {
		:global(.time-greeting-widget:not(.hidden)) {
			display: block;
		}
	}
</style>
