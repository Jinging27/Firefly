---
import { getImage, Image, Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import type { ImageFormat, ResponsiveImageLayout } from "@/types/config";
import {
	getFallbackFormat,
	getImageFormats,
	getImageQuality,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	// 响应式图像属性
	layout?: ResponsiveImageLayout;
	usePicture?: boolean;
	formats?: ImageFormat[];
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	quality?: number;
	fadeIn?: boolean;
	dataCoverImg?: boolean;
	showLqip?: boolean;
	showOverlay?: boolean;
	/** 仅在需要按视口选择资源时设置，生成带 media 的 source。 */
	media?: string;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority = "auto",
	layout = "constrained",
	usePicture = true,
	formats = getImageFormats(),
	width,
	height,
	widths,
	sizes,
	quality = getImageQuality(),
	fadeIn = true,
	dataCoverImg = false,
	showLqip = true,
	showOverlay = true,
	media,
} = Astro.props;

const fallbackFormat = getFallbackFormat();
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | null = null;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = fadeIn
	? "w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out"
	: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否需要添加 referrerpolicy（仅对非本地图片）
const fullSrc = isPublic ? url(src) : src;
const referrerPolicy =
	!isLocal && shouldAddNoReferrer(fullSrc) ? "no-referrer" : undefined;

// 构建响应式图像属性
const responsiveProps = {
	...(layout && { layout }),
	...(width && { width }),
	...(height && { height }),
	...(widths && { widths }),
	...(sizes && { sizes }),
	...(quality && { quality }),
};

const mediaImageResults =
	media && isLocal && img
		? await Promise.all(
				formats.map((format) =>
					getImage({
						...responsiveProps,
						src: img,
						format,
					} as Parameters<typeof getImage>[0]),
				),
			)
		: [];

// LQIP 渐变占位
const lqipProps = isLocal
	? getLqipProps(src, basePath)
	: isPublic
		? getLqipProps(src, basePath, true)
		: getLqipProps(src);
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    {fadeIn && showLqip && <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>}
    {showOverlay && <div class="transition absolute inset-0 dark:bg-black/10 pointer-events-none"></div>}
    {isLocal && img && media && (
        <picture>
            {mediaImageResults.map((image) => (
                <source
                    media={media}
                    srcset={image.srcSet.values.length > 0 ? image.srcSet.attribute : image.src}
                    type={image.options.format ? `image/${image.options.format}` : undefined}
                />
            ))}
            <img
                src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                alt={alt || ""}
                class={imageClass}
                style={imageStyle}
                loading={loading}
                fetchpriority={fetchpriority}
                data-cover-img={dataCoverImg ? true : undefined}
            />
        </picture>
    )}
    {isLocal && img && usePicture && !media && (
        <Picture
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            formats={formats}
            fallbackFormat={fallbackFormat}
            {...responsiveProps}
        />
    )}
    {isLocal && img && !usePicture && !media && (
        <Image
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            {...responsiveProps}
        />
    )}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading={loading} fetchpriority={fetchpriority} data-cover-img={dataCoverImg ? true : undefined} referrerpolicy={referrerPolicy} />}
</div>
